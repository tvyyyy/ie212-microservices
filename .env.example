# Copy to .env on the Docker host and fill credentials before running `docker compose up`.
# Never commit .env or actual credentials to Git.
# MinIO requirements: MINIO_ROOT_USER >= 3 chars, MINIO_ROOT_PASSWORD >= 8 chars.

MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Optional dedicated S3 access keys; defaults to MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml if blank.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

AWS_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true

ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://silver/warehouse

SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
