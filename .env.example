# Specify local values before deployment; these fields do not contain actual credentials.
# Default local Docker Linux ports: MinIO API 9000, MinIO Console 9001, Iceberg REST 8181.
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
AWS_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
